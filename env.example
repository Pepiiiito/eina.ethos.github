SESSION_SECRET=            # >= 32 caracteres aleatorios: openssl rand -hex 32
COOKIE_SECURE=auto         # auto (recomendado), true o false. auto = Secure solo con HTTPS
GEMINI_API_KEY=            # TU clave; nunca llega al navegador
GEMINI_MODEL=gemini-3-flash-preview
AI_DAILY_LIMIT=30          # generaciones IA por usuario y día
AI_MONTHLY_LIMIT=300
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_CREADOR=price_...   # ID del precio de 6,99 EUR
STRIPE_PRICE_PRO=price_...       # ID del precio de 14,99 EUR
# Tus Payment Links de Stripe (obligatorios; van aquí y NO en el código)
STRIPE_LINK_CREADOR=https://buy.stripe.com/...
STRIPE_LINK_PRO=https://buy.stripe.com/...
PORT=3000
DB_PATH=./ethos.db
TRUST_PROXY=false        # pon true en cualquier hosting con HTTPS (Render, Railway, Fly, Caddy, Nginx)
# En hosting pon DB_PATH=/data/ethos.db (dentro de un DISCO PERSISTENTE; si no, las cuentas se borran al reiniciar)
# Correo (verificación y recuperar contraseña). Cuenta gratis en resend.com + verificar tu dominio
RESEND_API_KEY=
MAIL_FROM=Ethos <no-reply@ethosfakechats.com>
APP_URL=https://ethosfakechats.com
